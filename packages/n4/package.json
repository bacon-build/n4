      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "index.ts"
  ],
  "keywords": [],
  "author": "",
  "license": "ISC",
  "scripts": {
    "lint": "tsc",
    "prebuild": "npm run lint",
    "build": "tsup index.ts --format cjs,esm --dts",
    "prepublish": "npm run build",
    "publish": "npm publish --access=public"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
